<launch>
  <arg
    name="model" />
  <param
    name="robot_description"
    textfile="$(find URDF_real3)/urdf/URDF_real3.urdf" />
  <node
    name="robot_state_publisher"
    pkg="robot_state_publisher"
    type="robot_state_publisher" />
  <node
    name="rviz"
    pkg="rviz"
    type="rviz"
    args="-d $(find URDF_real3)/urdf.rviz" /> 
</launch>
